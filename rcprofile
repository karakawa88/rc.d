# then
#     export XDG_RUNTIME_DIR="/run/user/$UID"
#     export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
# fi

# ripgrep
# ripgrepのデフォルトオプションの設定ファイル
export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"

# nvim
# bat
export BAT_CONFIG_PATH="/etc/rc.d/bat.conf"

# fzf
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
[ -f /etc/rc.d/rcprofzf ] && source /etc/rc.d/rcprofzf

# latex
export TEX_HOME="/usr/local/texlive/2025"

# Obsidian
export obsidian_vault_path="~/.obsidian/vault"

# Rust
export RUSTC_WRAPPER=$(which sccache)

#path
# export PATH="$MYSQL_BIN"
export PATH="/usr/local/bin:/bin:/usr/bin"
export PATH="$PATH:/usr/local/sbin:/sbin:/usr/sbin"
export PATH="$PYTHON_HOME/bin:$PATH"
export PATH="$TEX_HOME/bin/aarch64-linux:$PATH"
# cargoを使用するためパスを通す
# cabalのshellcheckを使用するためにパスをとうす
# 自分はPATHは初期化して設定するのでPATH設定前に設定すると
# PATHがとうらないのでPATH設定の後ろに設定
if [[ -r ~/.cargo/env ]]
then
    source ~/.cargo/env
fi
if [[ -r ~/.cabal ]]; then
    PATH="$PATH:$HOME/.cabal/bin"
fi
# Macのhomebrewのパスをとうす
if [[ $(uname) == "Darwin" ]]
then
        export PATH="$PATH:/opt/homebrew/bin"
fi
# fzf
if [[ -r ~/.fzf.zsh ]]; then
    source ~/.fzf.zsh
fi

